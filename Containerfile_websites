
# Stage 1: Base image
FROM fedora:latest AS base

RUN dnf -y upgrade && \
    dnf -y install httpd && \
    dnf clean all

RUN systemctl enable httpd

EXPOSE 80

ENTRYPOINT ["httpd", "-D", "FOREGROUND"]


# Stage 2: Website 1
FROM base AS website1

COPY website1.html /var/www/html/

LABEL website="1"


# Stage 3: Website 2
FROM base AS website2

COPY website2.html /var/www/html/

LABEL website="2"
